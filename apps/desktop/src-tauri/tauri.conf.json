{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobSniper",
  "version": "0.1.0",
  "identifier": "id.adefebrian.jobsniper",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/jobsniper-api",
      "binaries/jobsniper-crawler"
    ],
    "resources": {
      "../../../db/migrations": "migrations",
      "../../web/dist": "web"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "copyright": "Developed by Brian · adefebrian.com",
    "publisher": "Brian (adefebrian.com)"
  }
}
