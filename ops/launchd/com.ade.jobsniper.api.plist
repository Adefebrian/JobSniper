<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ade.jobsniper.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APPLICATION_SUPPORT__/jobsniper-api.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__APPLICATION_SUPPORT__/logs/api.out.log</string>
  <key>StandardErrorPath</key>
  <string>__APPLICATION_SUPPORT__/logs/api.err.log</string>
</dict>
</plist>
